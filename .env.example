# Copie a .env y reemplace los valores. En producción estos secretos viven en un gestor de secretos / KMS.
POSTGRES_PASSWORD=cambiar-esta-clave
INTERNAL_API_KEY=cambiar-clave-interna-larga-y-aleatoria
JWT_SECRET=cambiar-secreto-jwt-de-al-menos-32-caracteres
# Clave de 256 bits en base64 urlsafe. Genere con:
#   python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# Admite varias claves separadas por comas (la primera cifra; todas descifran) para rotación.
# El cifrado de campo es AES-256-GCM.
KMS_KEYS=
# 1 solo para la demostración (crea el usuario demo)
SEED_DEMO=1
